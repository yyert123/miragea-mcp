{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.yyert123/miragea-mcp",
  "title": "Miragea Voice & Captions",
  "description": "Voiceover, voice cloning and SRT/VTT captions for agents, with exact durations and Remotion scenes.",
  "repository": { "url": "https://github.com/yyert123/miragea-mcp", "source": "github" },
  "websiteUrl": "https://huggingface.co/spaces/headvox/miragea-mcp",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "miragea-mcp",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        { "name": "MIRAGEA_API_KEY", "description": "Miragea API key (https://miragea.ai)", "isRequired": true, "isSecret": true },
        { "name": "MIRAGEA_VOICE_ID", "description": "Default saved voice id (optional)", "isRequired": false, "isSecret": false },
        { "name": "MIRAGEA_OUTPUT_DIR", "description": "Folder for generated files (default ~/Miragea)", "isRequired": false, "isSecret": false }
      ]
    }
  ]
}
